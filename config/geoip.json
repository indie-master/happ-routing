{
  "input": [
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "swiftless-ru",
        "uri": "./swiftless-ru.txt"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "private",
        "uri": "./private.txt"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "swiftless-ru-whitelist",
        "uri": "./swiftless-ru-whitelist.txt"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "swiftless-wechat",
        "uri": "./swiftless-wechat.txt"
      }
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output-custom",
        "outputName": "geoip.dat"
      }
    }
  ]
}
